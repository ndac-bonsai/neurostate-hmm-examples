            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="p2:ModelSavePath">
                <p2:SavePath />
              </Combinator>
            </Expression>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="LoadPath" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="p2:OnlineHSMMLoadPath">
                <p2:LoadPath>ModelFitting\hsmm.pkl</p2:LoadPath>
              </Combinator>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>PythonClassName</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="py:ObserveOnGIL" />
            </Expression>
            <Expression xsi:type="Format">
              <Format>{0} = instantiateClass(cls={2}, {1}, {3})</Format>
              <Selector>Item1,Item2,Item3,Item4</Selector>
