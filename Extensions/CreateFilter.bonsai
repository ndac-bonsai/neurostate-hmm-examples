<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.8.5"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:p1="clr-namespace:neurostate_hmm;assembly=neurostate_hmm"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="WorkflowInput">
        <Name>Source1</Name>
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="IncomingSampleRate" />
        <Property Name="IncomingBufferLength" />
        <Property Name="IncomingBufferStepLength" />
        <Property Name="DownsampleFactor" />
        <Property Name="LfBandpass" />
        <Property Name="HfBandpass" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:FilterParameters">
          <p1:IncomingSampleRate>30000</p1:IncomingSampleRate>
          <p1:IncomingBufferLength>15000</p1:IncomingBufferLength>
          <p1:IncomingBufferStepLength>1200</p1:IncomingBufferStepLength>
          <p1:DownsampleFactor>30</p1:DownsampleFactor>
          <p1:LfBandpass>0.3</p1:LfBandpass>
          <p1:HfBandpass>250</p1:HfBandpass>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:BehaviorSubject">
        <Name>FilterObjectParameters</Name>
      </Expression>
      <Expression xsi:type="WorkflowOutput" />
    </Nodes>
    <Edges>
      <Edge From="0" To="2" Label="Source1" />
      <Edge From="1" To="2" Label="Source2" />
      <Edge From="2" To="3" Label="Source1" />
      <Edge From="3" To="4" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>